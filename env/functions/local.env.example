# Local development secrets for the Functions emulator. Copy this file to
# local.env (same folder — it is ignored) and fill in the values. The sync
# (scripts/sync-env.mjs, run by npm run dev / build / emulate) copies it to
# turboflow/functions/.env.local, which the emulator loads.
#
# In production these live in Secret Manager, not in any file:
#   firebase functions:secrets:set PAYPAL_CLIENT_ID --project <project>
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
DISCORD_WEBHOOK_URL=
