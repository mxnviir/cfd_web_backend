# Production (turboflow-7b3ca) functions config. Not secrets — those are in
# production's Secret Manager. Edit here, then deploy with
# `node scripts/deploy.mjs --project turboflow-7b3ca ...` (or run
# `node scripts/sync-env.mjs turboflow-7b3ca` by hand): the sync copies this
# file to turboflow/functions/.env.turboflow-7b3ca, which is the location
# firebase-tools reads at deploy time.

# Production's bucket is in us-central1; the upload triggers default to us-east1.
BUCKET_REGION=us-central1

# The worker. A new name beside production's original simscale-job, so the
# original worker keeps serving the original app and a rollback needs nothing
# renamed.
WORKER_JOB=simscale-worker

# Live PayPal. lib/config.ts only honours this on production itself.
PAYPAL_ENV=live
