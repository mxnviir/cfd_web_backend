# The SimScale worker's environment, for running it locally. Copy this file to
# simscale-job.env (same folder — it is ignored) and fill in the values. The
# worker loads that file when it exists, without overriding variables already
# set in the shell.
#
# In production these are set on the Cloud Run job, not in any file:
#   gcloud run jobs update simscale-worker --project <project> \
#     --set-env-vars SIMSCALE_API_KEY=...,SIMSCALE_PROJECT_ID=...,STORAGE_BUCKET=...
SIMSCALE_API_KEY=
SIMSCALE_API_BASE=https://api.simscale.com/v0
SIMSCALE_PROJECT_ID=
STORAGE_BUCKET=
GCP_PROJECT=
# Optional knobs; the values here are the code's own defaults:
# MAX_RUN_SECONDS=21600
# MAX_PACKAGE_BYTES=6442450944
# MAX_VIEWER_TRIANGLES=300000
# POLL_INTERVAL=15
