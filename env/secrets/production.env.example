# Template for production.env (same folder — the real file is ignored). These
# are the original app's live PayPal credentials and the Discord webhook that
# pings on every new job. Keep the real values in production.env and nowhere
# else; they also live in production's Secret Manager.
DISCORD_WEBHOOK_URL=
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
