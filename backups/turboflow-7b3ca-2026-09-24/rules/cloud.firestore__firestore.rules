rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStringOrNull(value) {
      return value == null || value is string;
    }

    function isMapOrNull(value) {
      return value == null || value is map;
    }

    // Compare each protected field via .get(k, default) so that fields which are
    // ABSENT on a document (e.g. sponsorRate / unlimitedUntil on a brand-new
    // account) compare equal instead of tripping absent-field comparison. This
    // still blocks any client attempt to change a protected value.
    function protectedUserFieldsUnchanged() {
      return request.resource.data.get('credits', 0) == resource.data.get('credits', 0)
        && request.resource.data.get('sponsored', false) == resource.data.get('sponsored', false)
        && request.resource.data.get('sponsorshipAmount', 0) == resource.data.get('sponsorshipAmount', 0)
        && request.resource.data.get('sponsorRate', 1) == resource.data.get('sponsorRate', 1)
        && request.resource.data.get('usdPerCredit', 0.05) == resource.data.get('usdPerCredit', 0.05)
        && request.resource.data.get('unlimitedUsd', 100) == resource.data.get('unlimitedUsd', 100)
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && request.resource.data.get('unlimitedUntil', 0) == resource.data.get('unlimitedUntil', 0);
    }

    function validUserProfileCreate() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'teamName',
          'credits',
          'sponsored',
          'sponsorshipAmount',
          'createdAt',
          'lastSeen',
          'region',
          'contactEmail',
          'lapCalcDefaults',
          'jobRaceTimes',
          'usdPerCredit',
          'unlimitedUsd'
        ])
        && request.resource.data.keys().hasAll([
          'email',
          'credits',
          'sponsored',
          'createdAt',
          'lastSeen'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.credits == 50
        && request.resource.data.sponsored == false
        // New accounts may only be created at the standard rates. Custom per-user
        // pricing is set later from the backend (Admin SDK), which bypasses rules.
        && (!('usdPerCredit' in request.resource.data) || request.resource.data.usdPerCredit == 0.05)
        && (!('unlimitedUsd' in request.resource.data) || request.resource.data.unlimitedUsd == 100)
        && (!('sponsorshipAmount' in request.resource.data) || request.resource.data.sponsorshipAmount == 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time
        && (!('name' in request.resource.data) || isStringOrNull(request.resource.data.name))
        && (!('teamName' in request.resource.data) || isStringOrNull(request.resource.data.teamName))
        && (!('region' in request.resource.data) || isStringOrNull(request.resource.data.region))
        && (!('contactEmail' in request.resource.data) || isStringOrNull(request.resource.data.contactEmail))
        && (!('lapCalcDefaults' in request.resource.data) || isMapOrNull(request.resource.data.lapCalcDefaults))
        && (!('jobRaceTimes' in request.resource.data) || isMapOrNull(request.resource.data.jobRaceTimes));
    }

    function validUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'teamName',
          'region',
          'contactEmail',
          'lapCalcDefaults',
          'jobRaceTimes',
          'lastSeen'
        ])
        && protectedUserFieldsUnchanged()
        && (!('name' in request.resource.data) || isStringOrNull(request.resource.data.name))
        && (!('teamName' in request.resource.data) || isStringOrNull(request.resource.data.teamName))
        && (!('region' in request.resource.data) || isStringOrNull(request.resource.data.region))
        && (!('contactEmail' in request.resource.data) || isStringOrNull(request.resource.data.contactEmail))
        && (!('lapCalcDefaults' in request.resource.data) || isMapOrNull(request.resource.data.lapCalcDefaults))
        && (!('jobRaceTimes' in request.resource.data) || isMapOrNull(request.resource.data.jobRaceTimes))
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
          || request.resource.data.lastSeen == request.time
        );
    }

    function validPendingJobCreate() {
      // The Fusion script writes many descriptive fields and a client-side
      // createdAt string. onNewJob re-clamps every untrusted numeric value
      // server-side, so the rule only enforces the two things that matter:
      // the job is owned by the caller and starts in 'pending'.
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUserProfileCreate();
      allow update: if isOwner(uid) && validUserProfileUpdate();
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validPendingJobCreate();
      allow update, delete: if false;
    }

    // Public pricing/config (rate, currency, PayPal client id).
    // Read-only for everyone; only writable from the backend (Admin SDK / Console).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // PayPal order intents  written and read only by Cloud Functions.
    match /paypal_orders/{orderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
