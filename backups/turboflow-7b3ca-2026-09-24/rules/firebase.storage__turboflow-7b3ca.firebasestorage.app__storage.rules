rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isJobOwner(jobId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/jobs/$(jobId))
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.userId == request.auth.uid;
    }

    match /jobs/{jobId}/{allPaths=**} {
      allow list: if false;
      // Uploads only need a signed-in user  the Fusion script writes files under
      // a random jobId before/around creating the job doc, so we can't require the
      // Firestore doc to pre-exist here. Reads/deletes stay owner-scoped.
      allow create, update: if isSignedIn();
      allow get, delete: if isJobOwner(jobId);
    }

    match /{allPaths=**} {
      allow list: if false;
      allow read, write: if false;
    }
  }
}
