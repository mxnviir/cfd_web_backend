# Edge function secrets for production. Copy to functions.prod.env (ignored),
# fill in, then:
#   supabase secrets set --env-file supabase/env/functions.prod.env --project-ref <prod-ref>
# Never commit the filled-in file. These are the values the Firebase build
# keeps in Secret Manager and env/secrets/production.env.
TURBOFLOW_ENV=production
SIMSCALE_API_BASE=https://api.simscale.com/v0
SIMSCALE_API_KEY=REPLACE_ME
SIMSCALE_PROJECT_ID=REPLACE_ME
# live only takes effect when TURBOFLOW_ENV=production.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_SECRET=REPLACE_ME
PAYPAL_WEBHOOK_ID=REPLACE_ME
DISCORD_WEBHOOK_URL=REPLACE_ME
