# Edge function secrets for a development project. Copy to functions.dev.env
# (ignored), then:
#   supabase secrets set --env-file supabase/env/functions.dev.env --project-ref <dev-ref>
#
# development lets the anonymous localhost session have an account.
TURBOFLOW_ENV=development
# The SimScale mock (supabase/functions/simscale-mock). Point at the real API
# and a real key to run real simulations from a development project.
SIMSCALE_API_BASE=https://<dev-ref>.supabase.co/functions/v1/simscale-mock/v0
SIMSCALE_API_KEY=mock-key
SIMSCALE_PROJECT_ID=mock-project
# Seconds each mocked SimScale operation takes.
MOCK_STAGE_SECONDS=30
# PayPal sandbox, if you want to exercise checkout. Leave unset otherwise.
PAYPAL_CLIENT_ID=unset
PAYPAL_SECRET=unset
PAYPAL_WEBHOOK_ID=unset
DISCORD_WEBHOOK_URL=unset
